# An Evening to Remember — static site, no build step.
#
# NOTE what is deliberately NOT ignored:
#   images/      the photographs are the site; they must be committed
#   analysis.js  generated by gen-analysis.py, but the page loads it at
#                runtime, so it ships with the site
#   app.js       its GALLERY block is generated by gen-gallery.js, same reason

# Environment / secrets
.env
.env.*
!.env.example

# Local scratch — probe and screenshot pages used while testing
_*.html

# Python (gen-analysis.py)
__pycache__/
*.py[cod]
.venv/
venv/

# Node (only if tooling is ever added — there is no build today)
node_modules/
dist/
npm-debug.log*

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs / misc
*.log
temp/
